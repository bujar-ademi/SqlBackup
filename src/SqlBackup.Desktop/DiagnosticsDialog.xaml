<Window x:Class="SqlBackup.Desktop.DiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="Job diagnostics" Width="880" Height="620" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Job diagnostics" FontSize="24" Foreground="#243E56" FontWeight="SemiBold" />
        <TextBlock x:Name="Status" Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#647D93"
                   Text="Check SQL capabilities, folder visibility and service access. Access checks create and remove a small test file; no backup or restore is executed." />
        <ListBox x:Name="Checks" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate>
                <StackPanel Margin="8,10">
                    <TextBlock FontWeight="SemiBold" Foreground="#243E56"><Run Text="{Binding Name}" /><Run Text=" · " /><Run Text="{Binding Status}" /></TextBlock>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RunButton" Content="Run checks" Padding="16,8" Click="Run_Click" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,8" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
