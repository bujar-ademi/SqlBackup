<Window x:Class="SqlBackup.Desktop.CleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="Cleanup preview and audit" Width="1000" Height="700" MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Recovery-aware cleanup" FontSize="24" Foreground="#243E56" FontWeight="SemiBold" />
        <TextBlock x:Name="Status" Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#647D93"
                   Text="Load a preview to review every retained and eligible file. Nothing is deleted until you confirm." />
        <DataGrid x:Name="Decisions" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Eligible" Binding="{Binding Delete}" Width="65" />
                <DataGridTextColumn Header="Database" Binding="{Binding Artifact.Database}" Width="110" />
                <DataGridTextColumn Header="Path" Binding="{Binding Artifact.Path}" Width="*" />
                <DataGridTextColumn Header="Decision" Binding="{Binding Reason}" Width="320" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="Audit" Grid.Row="3" Margin="0,14,0,14" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Text="Cleanup audit appears here." />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="Refresh preview" Padding="16,8" Click="Preview_Click" />
            <Button x:Name="DeleteButton" Content="Delete eligible files…" Padding="16,8" Margin="8,0" IsEnabled="False" Click="Delete_Click" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
