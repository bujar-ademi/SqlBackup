<Window x:Class="SqlBackup.Desktop.NotificationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="Notifications" Width="850" Height="610" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Notifications" FontSize="24" FontWeight="SemiBold" Foreground="#243E56" />
        <TextBlock x:Name="Status" Grid.Row="1" Text="Local alerts remain available while the desktop is closed." Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#647D93" />
        <ListBox x:Name="NotificationList" SelectionChanged="Selection_Changed" Grid.Row="2" BorderBrush="#DDE6EF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,10">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#243E56" />
                        <TextBlock Text="{Binding CreatedUtc, StringFormat='{}{0:u}'}" Foreground="#647D93" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        <Expander Header="Identifiers" Margin="0,8,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding JobId, StringFormat='Job: {0}'}" FontSize="11" Foreground="#647D93" />
                                <TextBlock Text="{Binding RunId, StringFormat='Run: {0}'}" FontSize="11" Foreground="#647D93" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="{Binding ReadUtc, StringFormat='Read: {0:u}', TargetNullValue='Unread'}" FontSize="11" Foreground="#647D93" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ViewButton" Content="View details" Padding="16,8" Margin="0,0,8,0" Click="View_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Content="Refresh" Padding="16,8" Click="Refresh_Click" />
            <Button x:Name="ReadButton" Content="Mark selected as read" Padding="16,8" Margin="8,0" Click="Read_Click" />
            <Button x:Name="ReadAllButton" Content="Mark all read" Padding="16,8" Margin="0,0,8,0" Click="ReadAll_Click" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
