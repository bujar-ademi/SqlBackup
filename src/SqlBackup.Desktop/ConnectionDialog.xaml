<Window x:Class="SqlBackup.Desktop.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="Connect to SQL Server" Width="590" Height="620" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="12" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Connect to SQL Server" FontSize="20" FontWeight="SemiBold" Foreground="#243E56" />
                <TextBlock Text="Connection settings for this backup job" Foreground="#74899D" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Editor" Margin="20,16">
                <TextBlock Text="Server type" />
                <ComboBox SelectedIndex="0" Padding="8,5" Margin="0,6,0,14">
                    <ComboBoxItem Content="Microsoft SQL Server" />
                </ComboBox>
                <TextBlock Text="Server name / instance" />
                <TextBox x:Name="ServerName" Padding="7,5" Margin="0,6,0,18" MaxLength="256" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="WindowsAuthentication" Content="Windows authentication" GroupName="Authentication" Checked="Authentication_Changed" Margin="0,0,20,0" ToolTip="Uses the AbaSqlBackup service's Windows identity" />
                    <RadioButton x:Name="SqlAuthentication" Content="SQL Server authentication" GroupName="Authentication" Checked="Authentication_Changed" />
                </StackPanel>
                <TextBlock Text="User name" />
                <TextBox x:Name="UserName" Padding="7,5" Margin="0,6,0,12" MaxLength="128" />
                <TextBlock Text="Password" />
                <PasswordBox x:Name="Password" Padding="7,5" Margin="0,6,0,5" MaxLength="1024" />
                <TextBlock Text="Leave empty to keep this job's saved password for the same server and login." TextWrapping="Wrap" Foreground="#7B8EA0" FontSize="11" Margin="0,0,0,18" />
                <Expander Header="Advanced settings" IsExpanded="True" Foreground="#365C7C">
                    <StackPanel Margin="20,12,0,0">
                        <CheckBox Content="Encrypt connection (required)" IsChecked="True" IsEnabled="False" Margin="0,0,0,10" />
                        <CheckBox x:Name="TrustCertificate" Content="Trust server certificate" />
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#58738A" Margin="0,18,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="20,15" BorderBrush="#DDE6EF" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="CancelButton" Content="Cancel" DockPanel.Dock="Right" Padding="13,6" Margin="8,0,0,0" IsCancel="True" />
                <Button x:Name="AcceptButton" Content="Save &amp; Close" DockPanel.Dock="Right" Padding="13,6" Click="Save_Click" IsDefault="True" />
                <Button x:Name="TestButton" Content="Test Connection" Padding="12,8" HorizontalAlignment="Left" Click="Test_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
