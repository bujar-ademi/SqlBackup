<Window x:Class="SqlBackup.Desktop.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="About SqlBackup" Width="600" Height="550" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/SqlBackup.Desktop;component/Assets/sqlbackup.png" Width="46" Height="46"
                       Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SqlBackup" FontSize="28" FontWeight="SemiBold" Foreground="#243E56" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Version" Margin="0,8,0,10" Foreground="#647D93" />
            <TextBlock FontSize="15" Margin="0,0,0,4" Foreground="#243E56">
                <Run Text="Created by " />
                <Hyperlink NavigateUri="https://bujarademi.com" RequestNavigate="AuthorWebsite_RequestNavigate" Foreground="#238052" FontWeight="SemiBold">Bujar Ademi</Hyperlink>
            </TextBlock>
            <TextBlock Text="bujarademi.com" Foreground="#647D93" FontSize="12" Margin="0,0,0,18" />
            <TextBlock Text="Your backups, under control" FontSize="17" FontWeight="SemiBold" Foreground="#243E56" />
            <TextBlock Text="Independent SQL jobs, schedules, verification, secondary copies and reviewed retention. Windows Service: AbaSqlBackup." TextWrapping="Wrap" Margin="0,12,0,18" />
            <TextBlock Text="Open-source release is planned. The license and public support/donation links are still to be selected. Core features have no donation requirement." TextWrapping="Wrap" Foreground="#647D93" />
            <TextBlock Text="When reporting an issue, include the application version, validation code and failed stage. Remove passwords, connection strings, database/customer names and backup contents." TextWrapping="Wrap" Margin="0,18,0,0" />
            <TextBlock Text="Backup checks and file integrity do not replace a validated restore test." TextWrapping="Wrap" Foreground="#647D93" Margin="0,18,0,0" />
            <TextBlock x:Name="DocumentationStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#647D93" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Documentation" Padding="14,8" Click="Docs_Click" Margin="0,0,8,0" />
            <Button Content="Close" Padding="18,8" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
