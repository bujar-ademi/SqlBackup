<Window x:Class="SqlBackup.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:SqlBackup.Core;assembly=SqlBackup.Core"
        Icon="/SqlBackup.Desktop;component/Assets/sqlbackup.ico"
        Title="SqlBackup" Width="1380" Height="810" MinWidth="1150" MinHeight="680"
        Background="#E5ECF5" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,5" /><Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#31526B" />
            <Setter Property="BorderBrush" Value="#CBD8E6" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#4B8CCC" /><Setter Property="Padding" Value="4,0" /><Setter Property="FontSize" Value="23" />
        </Style>
        <Style x:Key="SectionActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#427DB1" /><Setter Property="Padding" Value="0,3" />
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4" /><Setter Property="BorderBrush" Value="#CFDCE8" /><Setter Property="Foreground" Value="#253E54" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#415D73" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="Section" TargetType="Border"><Setter Property="Padding" Value="14,17" /><Setter Property="BorderBrush" Value="#D4DEE8" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#243E53" /></Style>
        <Style x:Key="Summary" TargetType="TextBlock"><Setter Property="Foreground" Value="#5C7890" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,10,0,0" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <DrawingImage x:Key="ServerIcon"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#455D69" Geometry="M2,2 H22 V8 H2 Z M2,10 H22 V16 H2 Z M2,18 H22 V24 H2 Z" />
            <GeometryDrawing Brush="#F3F7FC" Geometry="M4,4 H6 V6 H4 Z M4,12 H6 V14 H4 Z M4,20 H6 V22 H4 Z" />
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="DatabaseIcon"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#455D69" Geometry="M2,5 C2,0 22,0 22,5 L22,19 C22,25 2,25 2,19 Z" />
            <GeometryDrawing Geometry="M2,6 C2,11 22,11 22,6 M2,13 C2,18 22,18 22,13"><GeometryDrawing.Pen><Pen Brush="#F3F7FC" Thickness="1.5" /></GeometryDrawing.Pen></GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="FolderIcon"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#455D69" Geometry="M1,5 H10 L13,8 H23 V22 H1 Z" />
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="ScheduleIcon"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#455D69" Geometry="M3,3 H20 V8 H3 Z M3,10 H12 V22 H3 Z M17,11 A6,6 0 1 1 16.99,11 Z" />
            <GeometryDrawing Geometry="M17,13 V17 L20,18"><GeometryDrawing.Pen><Pen Brush="#F3F7FC" Thickness="1.5" /></GeometryDrawing.Pen></GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="MailIcon"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#455D69" Geometry="M1,5 H23 V21 H1 Z" />
            <GeometryDrawing Geometry="M1,5 L12,14 L23,5"><GeometryDrawing.Pen><Pen Brush="#F3F7FC" Thickness="1.5" /></GeometryDrawing.Pen></GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" Padding="14,0" BorderBrush="#D5DFEA" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" Content="About" Click="About_Click" Style="{StaticResource LinkButton}" Margin="14,0,0,0" />
                <Button x:Name="NotificationsButton" DockPanel.Dock="Right" Content="Notifications" Click="Notifications_Click" Style="{StaticResource LinkButton}" Margin="14,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Refresh service" Click="Refresh_Click" Style="{StaticResource LinkButton}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/SqlBackup.Desktop;component/Assets/sqlbackup.png" Width="27" Height="27" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SqlBackup" FontSize="18" FontWeight="SemiBold" Foreground="#243E53" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="7,6,7,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" MinWidth="460" /><ColumnDefinition Width="306" /></Grid.ColumnDefinitions>
            <Border Background="#354450" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Background="#2E3C48" Margin="0">
                        <Button x:Name="NewJobButton" Content="+" DockPanel.Dock="Right" Click="NewJob_Click" IsEnabled="False"
                                FontSize="30" Padding="8,0" Margin="0,0,7,0" Background="Transparent" Foreground="#DCE6EF" BorderThickness="0" ToolTip="Create job" />
                        <TextBlock Text="Jobs" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                    </DockPanel>
                    <ListBox x:Name="JobsList" Grid.Row="1" SelectionChanged="Jobs_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Padding="12,11" BorderBrush="#4B5965" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF1FA" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#526778" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBlock Text="●" Foreground="{Binding StatusColor}" FontSize="16" Margin="0,0,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E1EAF2" /><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="#253E53" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding NextRun}" Foreground="#91A8BB" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Background="#2E3C48" Margin="0" Height="56">
                        <TextBlock Text="YOUR BACKUPS, UNDER CONTROL" Foreground="#9FB4C6" FontSize="9" Margin="12,12,0,0" />
                        <TextBlock Text="Full · Differential · Log" Foreground="#D8E4ED" FontSize="11" Margin="12,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="#F3F7FC" Margin="0,0,6,0">
                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
                <Border BorderBrush="#D4DEE8" BorderThickness="0,0,0,1" Padding="12,0">
                    <DockPanel VerticalAlignment="Center">
                        <Button Content="▶  Run Now" DockPanel.Dock="Right" Click="RunJob_Click" Background="#F2FBF4" Foreground="#2B9256" BorderBrush="#8BCB9F"
                                Padding="12,4" Margin="8,0,0,0" IsEnabled="{Binding IsEnabled, ElementName=JobEditor}" />
                        <CheckBox x:Name="JobEnabled" Content="Enabled" DockPanel.Dock="Right" IsChecked="True" Margin="8,0,0,0"
                                  IsEnabled="{Binding IsEnabled, ElementName=JobEditor}" Checked="JobEnabled_Changed" Unchecked="JobEnabled_Changed" FontSize="10" />
                        <TextBlock x:Name="SelectedJobTitle" Visibility="Collapsed" />
                        <TextBox x:Name="JobName" MaxLength="100" FontSize="17" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0,2" ToolTip="Edit job name"
                                 IsEnabled="{Binding IsEnabled, ElementName=JobEditor}" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="JobEditor" IsEnabled="False">
                        <Border Style="{StaticResource Section}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Image Source="{StaticResource ServerIcon}" Width="25" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Connect to Microsoft SQL Server" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ConnectionSummary" Style="{StaticResource Summary}" /></StackPanel>
                            <Button Grid.Column="2" Content="&#xE713;" Click="Connection_Click" Style="{StaticResource SectionActionButton}" ToolTip="Connection settings" AutomationProperties.Name="Connection settings" />
                        </Grid></Border>
                        <Border Style="{StaticResource Section}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Image Source="{StaticResource DatabaseIcon}" Width="25" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Select databases" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="DatabaseSummary" Style="{StaticResource Summary}" /></StackPanel>
                            <Button Grid.Column="2" Content="&#xE713;" Click="Databases_Click" Style="{StaticResource SectionActionButton}" ToolTip="Select databases" AutomationProperties.Name="Select databases" />
                        </Grid></Border>
                        <Border Style="{StaticResource Section}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Image Source="{StaticResource FolderIcon}" Width="26" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Store backups in selected destinations" Style="{StaticResource SectionTitle}" />
                                <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="⋮" Click="Destination_Click" Style="{StaticResource IconButton}" FontSize="18" ToolTip="Edit backup destinations" />
                                    <TextBlock x:Name="DestinationSummary" Foreground="#5C7890" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <Button Content="Cleanup &amp; audit" Click="Cleanup_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,5,0,0" FontSize="10" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="⊕" Click="AddDestination_Click" Style="{StaticResource SectionActionButton}" FontFamily="Segoe UI Symbol" Foreground="#4CAD65" ToolTip="Add destination: Local / NAS, Azure Blob or Amazon S3" AutomationProperties.Name="Add destination" />
                        </Grid></Border>
                        <Border Style="{StaticResource Section}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <Image Source="{StaticResource ScheduleIcon}" Width="27" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Schedule backups" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="ScheduleSummary" Style="{StaticResource Summary}" /></StackPanel>
                            <Button Grid.Column="2" Content="&#xE713;" Click="Schedule_Click" Style="{StaticResource SectionActionButton}" ToolTip="Advanced backup schedule" AutomationProperties.Name="Advanced backup schedule" />
                        </Grid></Border>
                        <Border Style="{StaticResource Section}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <Image Source="{StaticResource MailIcon}" Width="26" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Send confirmation" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="NotifyFailure" Content="Failures / interruptions" IsChecked="True" Margin="0,0,18,0" /><CheckBox x:Name="NotifySuccess" Content="Success" /></WrapPanel>
                                <TextBlock Text="Local notification inbox" Foreground="#8396A5" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid></Border>
                        <Expander Header="More settings…" Foreground="#427DB1" Margin="12,14,12,16">
                            <StackPanel Margin="24,12,0,0">
                                <TextBlock Text="Backup options" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <CheckBox x:Name="Checksum" Content="Create backup checksums" Margin="0,0,0,8" />
                                <CheckBox x:Name="Verify" Content="Verify with RESTORE VERIFYONLY" Margin="0,0,0,8" />
                                <CheckBox x:Name="Compression" Content="Compress backup (supported editions)" Margin="0,0,0,8" />
                                <CheckBox x:Name="CopyOnly" Content="Copy-only manual Full — preserve the Differential base" Margin="0,0,0,16" />
                                <TextBlock Text="Database health · saved job" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <DataGrid x:Name="DatabaseHealth" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150" MinHeight="60" HeadersVisibility="Column" FontSize="10">
                                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Message}" /></Style></DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="*" MinWidth="120" />
                                        <DataGridTextColumn Header="Last backup UTC" Binding="{Binding LastBackupUtc, StringFormat='{}{0:MM-dd HH:mm}', TargetNullValue='Never'}" Width="100" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding LastBackupType}" Width="55" /><DataGridTextColumn Header="Backup" Binding="{Binding Backup}" Width="65" />
                                        <DataGridTextColumn Header="Verify" Binding="{Binding Verification}" Width="65" /><DataGridTextColumn Header="Copy" Binding="{Binding CopyStatus}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Run diagnostics…" Click="Diagnostics_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Row="2" Background="#ECF2F9" Margin="0" IsEnabled="{Binding IsEnabled, ElementName=JobEditor}">
                    <Button Content="Delete job" DockPanel.Dock="Right" Click="DeleteJob_Click" Style="{StaticResource LinkButton}" Foreground="#A96962" Margin="12,0" />
                    <Button Content="Save job" Click="SaveJob_Click" Background="#3477AB" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="12,6" />
                </DockPanel>
            </Grid>
            <Grid Grid.Column="2" Background="#F3F7FC">
                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="34" /><RowDefinition Height="34" /></Grid.RowDefinitions>
                <Border BorderBrush="#D4DEE8" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel VerticalAlignment="Center">
                    <Button Content="↻" DockPanel.Dock="Right" Click="History_Click" Style="{StaticResource IconButton}" FontSize="18" ToolTip="Refresh history" />
                    <TextBlock Text="History" FontSize="17" FontWeight="SemiBold" Foreground="#243E53" VerticalAlignment="Center" />
                </DockPanel></Border>
                <Expander Grid.Row="1" Header="Filter history" Foreground="#70899D" Margin="10,8" FontSize="10">
                    <StackPanel Margin="0,8,0,4">
                        <CheckBox x:Name="HistoryThisJob" Content="Selected job only" IsChecked="True" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="HistoryStatus" Padding="3" Margin="0,0,3,0" /><ComboBox x:Name="HistoryType" Grid.Column="1" Padding="3" Margin="3,0,0,0" />
                        </Grid>
                        <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="From (local)" /><TextBlock Text="Through (local)" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <DatePicker x:Name="HistoryFrom" Margin="0,0,3,0" /><DatePicker x:Name="HistoryTo" Grid.Column="1" Margin="3,0,0,0" />
                        </Grid>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Apply" Click="HistoryApply_Click" Padding="9,4" Margin="7,0,0,0" /><TextBox x:Name="HistoryDatabase" ToolTip="Exact database name, optional" /></DockPanel>
                    </StackPanel>
                </Expander>
                <ListBox x:Name="HistoryList" Grid.Row="2" Margin="5,0" MouseDoubleClick="History_OpenLog"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="3,4" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid>
                            <Grid.ToolTip><StackPanel><TextBlock Text="{Binding JobName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" /><TextBlock Text="{Binding Stages}" /></StackPanel></Grid.ToolTip>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="19" /><ColumnDefinition Width="61" /><ColumnDefinition Width="69" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LocalTimeLabel}" FontSize="11" Foreground="#516F88" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusSymbol}" Foreground="{Binding StatusColor}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TypeText}" Foreground="#365D7B" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#365D7B" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="⋮" Style="{StaticResource IconButton}" FontSize="17" Padding="1,0" Click="HistoryMenu_Click" Tag="{Binding}" ToolTip="View job log" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Grid.Row="3" Margin="9,0">
                    <Button x:Name="NextHistoryButton" Content="›" DockPanel.Dock="Right" Click="HistoryNext_Click" Padding="9,2" IsEnabled="False" />
                    <Button x:Name="PreviousHistoryButton" Content="‹" DockPanel.Dock="Left" Click="HistoryPrevious_Click" Padding="9,2" IsEnabled="False" />
                    <TextBlock x:Name="HistoryPageLabel" Text="No executions" FontSize="10" Foreground="#7B92A5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
                <Button Grid.Row="4" Content="Open selected job log" Click="History_OpenLog" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="12,0" FontSize="11" />
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#F8FBFE" Padding="12,6">
            <StackPanel>
                <TextBlock x:Name="ServiceStatus" Text="Checking service…" Foreground="#5E788D" FontSize="10" />
                <Border x:Name="ResultBanner" CornerRadius="3" Padding="7,5" Margin="0,4,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF1F8" /><Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=Result}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <TextBlock x:Name="Result" TextWrapping="Wrap" Foreground="#36556D" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
